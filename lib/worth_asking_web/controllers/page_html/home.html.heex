<Layouts.flash_group flash={@flash} />

<div class="max-w-3xl mx-auto px-6">
  <%!-- Hero --%>
  <div class="text-center py-16 lg:py-24">
    <h1 class="text-4xl lg:text-5xl font-semibold tracking-tight mb-5 leading-tight" style="font-family: Georgia, serif;">
      Ask women what you actually want to know.
    </h1>
    <p class="text-lg text-[#2F2F2F]/70 max-w-2xl mx-auto mb-4 leading-relaxed">
      Get honest, anonymous perspective from real women on dating, relationships, style, grooming, communication, sex, gifts, work situations, and the questions you may not want to ask people in your real life.
    </p>
    <p class="text-sm text-[#2F2F2F]/40 mb-8">
      Anonymous &bull; Direct &bull; No judgment &bull; Real female perspective
    </p>
    <div class="flex items-center justify-center gap-4">
      <a
        href="#ask"
        class="bg-[#6F8F9D] text-white px-6 py-3 rounded-lg text-sm font-medium hover:bg-[#5a7a87] transition-colors"
      >
        Ask a Question
      </a>
      <a
        href="#how-it-works"
        class="border border-[#E4E6E3] text-[#2F2F2F]/70 px-6 py-3 rounded-lg text-sm font-medium hover:border-[#6F8F9D] hover:text-[#6F8F9D] transition-colors"
      >
        See How It Works
      </a>
    </div>
  </div>

  <%!-- Question Input Section --%>
  <div id="ask" class="mb-20 scroll-mt-8">
    <div class="bg-white border border-[#E4E6E3] rounded-lg p-8 max-w-xl mx-auto">
      <h2 class="text-2xl font-semibold mb-2" style="font-family: Georgia, serif;">
        What do you want to ask?
      </h2>
      <p class="text-sm text-[#2F2F2F]/50 mb-6">
        Type your question below. You'll create a free account after this so we know where to send your responses.
      </p>
      <form action={~p"/ask"} method="get">
        <textarea
          name="q"
          rows="4"
          required
          minlength="20"
          placeholder="Example: &quot;What does it mean if she says she's not ready for anything serious but still texts me every day?&quot;"
          class="w-full border border-[#E4E6E3] rounded-lg p-4 text-sm resize-none focus:outline-none focus:border-[#6F8F9D] focus:ring-1 focus:ring-[#6F8F9D] bg-[#F7F7F5] leading-relaxed"
        ></textarea>
        <button
          type="submit"
          class="mt-4 w-full bg-[#6F8F9D] text-white py-3 rounded-lg text-sm font-medium hover:bg-[#5a7a87] transition-colors"
        >
          Continue
        </button>
      </form>
      <p class="text-xs text-center text-[#2F2F2F]/40 mt-3">
        Free to start &bull; Your question stays anonymous
      </p>
    </div>
  </div>

  <%!-- How It Works --%>
  <div id="how-it-works" class="mb-20 scroll-mt-8">
    <h2 class="text-sm font-medium text-[#2F2F2F]/50 uppercase tracking-wider mb-8 text-center">
      How Worth Asking Works
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="text-center">
        <div class="w-10 h-10 rounded-full bg-[#6F8F9D]/10 flex items-center justify-center mx-auto mb-3">
          <span class="text-sm font-semibold text-[#6F8F9D]">1</span>
        </div>
        <h3 class="font-medium mb-1">Ask your question</h3>
        <p class="text-xs text-[#2F2F2F]/50 leading-relaxed">
          Write the thing you actually want a woman's perspective on.
        </p>
      </div>
      <div class="text-center">
        <div class="w-10 h-10 rounded-full bg-[#6F8F9D]/10 flex items-center justify-center mx-auto mb-3">
          <span class="text-sm font-semibold text-[#6F8F9D]">2</span>
        </div>
        <h3 class="font-medium mb-1">We send it to contributors</h3>
        <p class="text-xs text-[#2F2F2F]/50 leading-relaxed">
          Your question is matched with women whose selected topics fit your question.
        </p>
      </div>
      <div class="text-center">
        <div class="w-10 h-10 rounded-full bg-[#6F8F9D]/10 flex items-center justify-center mx-auto mb-3">
          <span class="text-sm font-semibold text-[#6F8F9D]">3</span>
        </div>
        <h3 class="font-medium mb-1">Get honest responses</h3>
        <p class="text-xs text-[#2F2F2F]/50 leading-relaxed">
          Receive multiple perspectives from women who are not emotionally involved in your situation.
        </p>
      </div>
      <div class="text-center">
        <div class="w-10 h-10 rounded-full bg-[#6F8F9D]/10 flex items-center justify-center mx-auto mb-3">
          <span class="text-sm font-semibold text-[#6F8F9D]">4</span>
        </div>
        <h3 class="font-medium mb-1">Use what helps</h3>
        <p class="text-xs text-[#2F2F2F]/50 leading-relaxed">
          Read the responses, compare perspectives, and decide what makes sense for you.
        </p>
      </div>
    </div>
  </div>

  <%!-- Why Create an Account --%>
  <div class="mb-20">
    <div class="bg-[#F7F7F5] border border-[#E4E6E3] rounded-lg p-8 max-w-xl mx-auto">
      <h3 class="font-medium mb-3">Why create an account?</h3>
      <p class="text-sm text-[#2F2F2F]/60 mb-3">We need an account so you can:</p>
      <ul class="space-y-2 text-sm text-[#2F2F2F]/60">
        <li class="flex items-start gap-2">
          <span class="text-[#6F8F9D] mt-0.5">&#10003;</span>
          Save your question
        </li>
        <li class="flex items-start gap-2">
          <span class="text-[#6F8F9D] mt-0.5">&#10003;</span>
          Receive your responses
        </li>
        <li class="flex items-start gap-2">
          <span class="text-[#6F8F9D] mt-0.5">&#10003;</span>
          Get notified when answers are ready
        </li>
        <li class="flex items-start gap-2">
          <span class="text-[#6F8F9D] mt-0.5">&#10003;</span>
          Ask follow-up questions
        </li>
        <li class="flex items-start gap-2">
          <span class="text-[#6F8F9D] mt-0.5">&#10003;</span>
          Keep your activity anonymous and private
        </li>
      </ul>
    </div>
  </div>

  <%!-- FAQ --%>
  <div class="mb-20">
    <h2 class="text-sm font-medium text-[#2F2F2F]/50 uppercase tracking-wider mb-8 text-center">
      Frequently Asked Questions
    </h2>
    <div class="space-y-6 max-w-xl mx-auto">
      <div>
        <h3 class="font-medium mb-1">Is this anonymous?</h3>
        <p class="text-sm text-[#2F2F2F]/60 leading-relaxed">
          Yes. Contributors do not see your name, email, or personal account details.
        </p>
      </div>
      <div>
        <h3 class="font-medium mb-1">Who answers the questions?</h3>
        <p class="text-sm text-[#2F2F2F]/60 leading-relaxed">
          Women contributors who have selected topics they are comfortable answering.
        </p>
      </div>
      <div>
        <h3 class="font-medium mb-1">Why do I need an account?</h3>
        <p class="text-sm text-[#2F2F2F]/60 leading-relaxed">
          So we can save your question, send your responses, and allow you to ask follow-ups.
        </p>
      </div>
      <div>
        <h3 class="font-medium mb-1">Is this therapy?</h3>
        <p class="text-sm text-[#2F2F2F]/60 leading-relaxed">
          No. Worth Asking is not therapy, counseling, or crisis support. It is a way to get honest female perspective on everyday questions.
        </p>
      </div>
      <div>
        <h3 class="font-medium mb-1">Can I ask about sex?</h3>
        <p class="text-sm text-[#2F2F2F]/60 leading-relaxed">
          Yes, as long as the question is respectful and does not involve illegal, harmful, or abusive content.
        </p>
      </div>
    </div>
  </div>

  <%!-- Contributor CTA --%>
  <div class="mb-16 text-center">
    <div class="border border-[#A8BDA4] rounded-lg p-8 bg-[#A8BDA4]/5 max-w-xl mx-auto">
      <h2 class="text-xl font-semibold mb-2" style="font-family: Georgia, serif;">
        Want to share your perspective?
      </h2>
      <p class="text-sm text-[#2F2F2F]/60 mb-4 leading-relaxed">
        Join as a contributor. Respond on your schedule, stay anonymous, and earn money for thoughtful answers.
      </p>
      <a
        href={~p"/contributors/join"}
        class="inline-block bg-[#6F8F6B] text-white px-6 py-3 rounded-lg text-sm font-medium hover:bg-[#5a7a57] transition-colors"
      >
        Apply to be a contributor
      </a>
    </div>
  </div>

  <%!-- Footer --%>
  <div class="pt-8 border-t border-[#E4E6E3] text-center pb-12">
    <p class="text-sm text-[#2F2F2F]/40">
      Honest perspective. Anonymous questions. Real answers.
    </p>
  </div>
</div>
