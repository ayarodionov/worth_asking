<div class="max-w-lg mx-auto px-6 py-16 lg:py-24">
  <div class="text-center mb-10">
    <div class="w-14 h-14 rounded-full bg-[#A8BDA4]/20 flex items-center justify-center mx-auto mb-5">
      <span class="text-[#6F8F6B] text-2xl">&#9734;</span>
    </div>
    <h1 class="text-3xl font-semibold tracking-tight mb-3" style="font-family: Georgia, serif;">
      Become a contributor
    </h1>
    <p class="text-[#2F2F2F]/60 max-w-sm mx-auto">
      Share your perspective, help men understand what they're missing, and earn money doing it.
    </p>
  </div>

  <div class="bg-white border border-[#E4E6E3] rounded-lg p-8 mb-8">
    <h2 class="text-sm font-medium text-[#2F2F2F]/50 uppercase tracking-wider mb-6">How it works</h2>
    <div class="space-y-4 mb-8">
      <div class="flex items-start gap-4">
        <div class="w-7 h-7 rounded-full bg-[#A8BDA4]/20 flex items-center justify-center flex-shrink-0 mt-0.5">
          <span class="text-xs font-semibold text-[#6F8F6B]">1</span>
        </div>
        <div>
          <p class="text-sm font-medium text-[#2F2F2F]">Create your account</p>
          <p class="text-xs text-[#2F2F2F]/50">Just your email. No password needed.</p>
        </div>
      </div>
      <div class="flex items-start gap-4">
        <div class="w-7 h-7 rounded-full bg-[#A8BDA4]/20 flex items-center justify-center flex-shrink-0 mt-0.5">
          <span class="text-xs font-semibold text-[#6F8F6B]">2</span>
        </div>
        <div>
          <p class="text-sm font-medium text-[#2F2F2F]">Complete a short questionnaire</p>
          <p class="text-xs text-[#2F2F2F]/50">Respond to real-world scenarios so we can evaluate your empathy and communication style.</p>
        </div>
      </div>
      <div class="flex items-start gap-4">
        <div class="w-7 h-7 rounded-full bg-[#A8BDA4]/20 flex items-center justify-center flex-shrink-0 mt-0.5">
          <span class="text-xs font-semibold text-[#6F8F6B]">3</span>
        </div>
        <div>
          <p class="text-sm font-medium text-[#2F2F2F]">Get approved and start earning</p>
          <p class="text-xs text-[#2F2F2F]/50">Once approved, you'll see questions and get paid for each response.</p>
        </div>
      </div>
    </div>

    <.form :let={f} for={@changeset} action={~p"/contributors/join"}>
      <.input
        field={f[:email]}
        type="email"
        label="Your email"
        placeholder="you@example.com"
        autocomplete="email"
        required
      />

      <.button class="w-full mt-4 py-3 rounded-lg text-sm font-medium bg-[#6F8F6B] text-white hover:bg-[#5a7a57] transition-colors">
        Get started
      </.button>
    </.form>
  </div>

  <div class="text-center">
    <p class="text-xs text-[#2F2F2F]/40">
      Already have an account?
      <a href={~p"/users/log-in"} class="text-[#6F8F9D] hover:underline">Log in</a>
    </p>
  </div>
</div>
