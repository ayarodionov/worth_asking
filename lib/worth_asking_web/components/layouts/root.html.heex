<!DOCTYPE html>
<html lang="en" data-theme="worth-asking">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Worth Asking" suffix=" - Get a second perspective">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-[#F7F7F5] text-[#2F2F2F] min-h-screen">
    <%= if assigns[:admin_login_page] do %>
      <%!-- No nav on admin login page --%>
    <% else %>
    <%= if assigns[:current_admin] do %>
      <nav class="w-full px-6 lg:px-12 py-4 flex items-center justify-between border-b border-[#2F2F2F]/10 bg-[#2F2F2F]">
        <a href={~p"/admin"} class="text-xl font-semibold tracking-tight text-white" style="font-family: Georgia, serif;">
          Worth Asking <span class="text-white/40 text-sm font-normal ml-2">Admin</span>
        </a>
        <div class="flex items-center gap-6 text-sm">
          <a href={~p"/admin"} class="text-white/70 hover:text-white transition-colors">Dashboard</a>
          <a href={~p"/admin/contributors"} class="text-white/70 hover:text-white transition-colors">Contributors</a>
          <a href={~p"/admin/applications"} class="text-white/70 hover:text-white transition-colors">Applications</a>
          <a href={~p"/admin/reports"} class="text-white/70 hover:text-white transition-colors">Reports</a>
          <.link href={~p"/admin/logout"} method="delete" class="text-white/40 hover:text-white/70 transition-colors">
            Log out
          </.link>
        </div>
      </nav>
    <% else %>
      <nav class="w-full px-6 lg:px-12 py-4 flex items-center justify-between border-b border-[#E4E6E3]">
        <a href={~p"/"} class="text-xl font-semibold tracking-tight text-[#2F2F2F]" style="font-family: Georgia, serif;">
          Worth Asking
        </a>
        <div class="flex items-center gap-4 lg:gap-6 text-sm">
          <a href="/about" class="hover:text-[#6F8F9D] transition-colors">About</a>
          <a href="/field-notes" class="hover:text-[#6F8F9D] transition-colors">Field Notes</a>
          <%= if @current_scope && @current_scope.user do %>
            <%= if @current_scope.user.role in [:contributor, :admin] do %>
              <a href={~p"/dashboard"} class="hover:text-[#6F8F9D] transition-colors">Dashboard</a>
            <% else %>
              <a href={~p"/my-questions"} class="hover:text-[#6F8F9D] transition-colors">Dashboard</a>
            <% end %>
            <a href={~p"/users/settings"} class="hover:text-[#6F8F9D] transition-colors">Settings</a>
            <.link href={~p"/users/log-out"} method="delete" class="hover:text-[#6F8F9D] transition-colors">
              Log out
            </.link>
          <% else %>
            <a href={~p"/contributors/join"} class="text-[#6F8F6B] font-medium hover:underline transition-colors hidden sm:inline">
              Become a contributor
            </a>
            <a href={~p"/users/log-in"} class="hover:text-[#6F8F9D] transition-colors">Log in</a>
            <a href="/#ask" class="bg-[#6F8F9D] text-white px-4 py-2 rounded-md hover:bg-[#5a7a87] transition-colors">
              Ask a Question
            </a>
          <% end %>
        </div>
      </nav>
    <% end %>
    <% end %>
    {@inner_content}
  </body>
</html>
